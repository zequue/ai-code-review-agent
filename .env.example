# Proveedor del modelo: "ollama" (local, default) u "openai" (cualquier API compatible con OpenAI)
LLM_PROVIDER=ollama
# ollama: host sin /v1. openai: URL base del proveedor (vacío = api.openai.com)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
# Solo para LLM_PROVIDER=openai
LLM_API_KEY=
# Opcionales
LLM_TIMEOUT_S=180
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=30m
LLM_MAX_TOKENS=1024
# Guía de revisión del equipo que se suma al prompt. "none" la desactiva.
LLM_GUIDELINES=reviewer/guidelines.md

# Publicar la revisión en un PR (opcional, fase 7)
GITHUB_TOKEN=
GITHUB_REPO=zequue/ai-code-review-agent
